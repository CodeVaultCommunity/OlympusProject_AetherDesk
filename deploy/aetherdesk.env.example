# Copiar para /etc/aetherdesk/aetherdesk.env com chmod 0600.
# Gerar segredos independentes com: openssl rand -base64 48
AETHERDESK_BOOTSTRAP_TOKEN=SUBSTITUA_POR_SEGREDO_ALEATORIO
AETHERDESK_CSRF_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO
AETHERDESK_BROKER_SECRET_B64=SUBSTITUA_POR_BASE64_DE_48_BYTES_ALEATORIOS
# Vazio: tombstone sem data de purga. Não ativa exclusão física automática.
AETHERDESK_ACCOUNT_RETENTION_SECONDS=
# Limite de sessões tmux persistentes abertas por conta (1 a 64).
AETHERDESK_MAX_TERMINAL_SESSIONS_PER_ACCOUNT=8
AETHERDESK_BROKER_AUDIT_LOG=/var/log/aetherdesk-broker/audit.log
# Rotação local da trilha redigida; ajuste ao armazenamento e retenção do host.
AETHERDESK_BROKER_AUDIT_MAX_BYTES=10485760
AETHERDESK_BROKER_AUDIT_BACKUPS=5
AETHERDESK_DATA_DIR=/var/lib/aetherdesk
AETHERDESK_RUNTIME_IMAGE=aetherdesk-files:w003
# Features v2 são opt-in e devem coincidir nos serviços web e broker.
# AETHERDESK_FEATURES=ide,workloads,ai
# AETHERDESK_KILL_DEPLOYS=1
# AETHERDESK_KILL_AI=1
# AETHERDESK_SAFE_MODE=1
# Ativar somente com DNS/proxy TLS wildcard para *.apps.local em origem separada.
# AETHERDESK_ENABLE_WORKLOAD_PROXY=1
# Com ide habilitada, usar imagem do agente workspace-v2 construída e pinada por digest.
# AETHERDESK_RUNTIME_IMAGE=aetherdesk-files@sha256:SUBSTITUA_PELO_DIGEST_VERIFICADO
# Backup com features v2 exige chave independente de 32 bytes em base64.
# AETHERDESK_BACKUP_KEY_B64=SUBSTITUA_POR_BASE64_DE_32_BYTES_ALEATORIOS
# Workloads exigem templates com scan, SBOM, provenance e assinatura do operador.
# AETHERDESK_WORKLOAD_SIGNING_KEY_B64=SUBSTITUA_POR_BASE64_DE_32_BYTES_ALEATORIOS
# AETHERDESK_MASTER_KEY_B64=SUBSTITUA_POR_BASE64_DE_32_BYTES_ALEATORIOS
# AETHERDESK_WORKLOAD_TEMPLATE_DIR=/etc/aetherdesk/templates
