[Unit]
Description=AetherDesk private web desktop
Wants=network-online.target
After=network-online.target aetherdesk-broker.service
Requires=aetherdesk-broker.service

[Service]
Type=simple
User=aetherdesk
Group=aetherdesk
WorkingDirectory=/opt/aetherdesk
EnvironmentFile=/etc/aetherdesk/aetherdesk.env
Environment=PYTHONUNBUFFERED=1
Environment=AETHERDESK_BROKER_SOCKET=/run/aetherdesk-broker/broker.sock
ExecStart=/opt/aetherdesk/.venv/bin/uvicorn launch:create_app --factory --host 127.0.0.1 --port 8174 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aetherdesk
UMask=0007

[Install]
WantedBy=multi-user.target
