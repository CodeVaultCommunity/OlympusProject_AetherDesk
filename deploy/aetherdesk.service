[Unit]
Description=AetherDesk private web desktop
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=aetherdesk
Group=aetherdesk
SupplementaryGroups=docker
WorkingDirectory=/opt/aetherdesk
EnvironmentFile=/etc/aetherdesk/aetherdesk.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/aetherdesk/.venv/bin/uvicorn launch:create_app --factory --host 127.0.0.1 --port 8174 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
